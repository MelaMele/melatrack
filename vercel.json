{
  "rewrites": [
    {
      "source": "/api/employees",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/checkin",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/report",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin",
      "destination": "/public/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
